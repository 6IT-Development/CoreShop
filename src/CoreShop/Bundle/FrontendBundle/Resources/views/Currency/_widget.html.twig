<li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle" href="#" id="currencyDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" {{ coreshop_test_html_attribute('currency-selector') }}>
        {{ 'coreshop.ui.currency'|trans }}
    </a>
    <div class="dropdown-menu" aria-labelledby="currencyDropdown" >
        {% for currency in currencies %}
            {# POST without a CSRF token: a token here would start a session for every anonymous visitor #}
            <form method="post" action="{{ path('coreshop_switch_currency', {'currencyCode': currency.isoCode}) }}">
                <button type="submit" class="dropdown-item" {{ coreshop_test_html_attribute('currency-selector-code', currency.isoCode) }}>
                    {{ currency.name }} ({{ currency.isoCode }})
                </button>
            </form>
        {% endfor %}
    </div>
</li>
