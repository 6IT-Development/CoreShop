{% extends '@CoreShopFrontend/layout.html.twig' %}
{% form_theme form '@CoreShopFrontend/Common/theme.html.twig' %}

{% block content %}
   <div id="main-container" class="order-return-container container p-0">

      <nav aria-label="breadcrumb">
         <ol class="breadcrumb">
            <li class="breadcrumb-item">
               <a href="{{ path('coreshop_index') }}">{{ 'coreshop.ui.home'|trans }}</a>
            </li>
            <li class="breadcrumb-item active">{{ 'coreshop.ui.order_return'|trans }}</li>
         </ol>
      </nav>

      <h1>{{ 'coreshop.ui.order_return.form.title'|trans }}</h1>
      <p>{{ 'coreshop.ui.order_return.form.desc'|trans }}</p>

      {% if success|default(false) %}
          <div class="alert alert-success mt-4">
              {{ 'coreshop.ui.order_return.form.success'|trans }}
          </div>
          {% if pdfUrl is defined %}
              <div class="mt-4">
                  <a href="{{ pdfUrl }}" class="btn btn-primary" target="_blank">
                      <i class="fa fa-file-pdf-o"></i> {{ 'coreshop.ui.order_return.form.download_pdf'|trans }}
                  </a>
              </div>
          {% endif %}
      {% else %}
          {{ form_start(form) }}
          {{ form_widget(form) }}
          {{ form_end(form) }}

          <p class="order-return-confirm mt-3">
             {{ 'coreshop.ui.order_return.form.confirm'|trans }}
          </p>
      {% endif %}
   </div>
{% endblock %}