{
  "name": "coreshop/address",
  "type": "library",
  "description": "CoreShop Address Component.",
  "keywords": [
    "coreshop",
    "pimcore",
    "ecommerce",
    "address"
  ],
  "homepage": "https://www.coreshop.com",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "CoreShop Team",
      "email": "info@coreshop.com",
      "homepage": "https://www.coreshop.com/",
      "role": "Developer"
    },
    {
      "name": "Dominik Pfaffenbauer",
      "email": "dominik@pfaffenbauer.at",
      "homepage": "https://www.pfaffenbauer.at/",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.4",
    "coreshop/resource": "^4.0",
    "doctrine/collections": "^1.6 | ^2.0",
    "doctrine/orm": "^2.9",
    "laminas/laminas-stdlib": "^3.6",
    "six-it/pimcore-source": "^2.1",
    "symfony/http-foundation": "^7.4",
    "symfony/service-contracts": "^3.5",
    "symfony/translation-contracts": "^3.0",
    "twig/twig": "^3.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpstan/phpstan-webmozart-assert": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "CoreShop\\Component\\Address\\": ""
    }
  },
  "repositories": [
      {
          "type": "path",
          "url": "../../*/*"
      }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "branch-alias": {
      "dev-master": "4.1-dev"
    }
  },
  "config": {
    "sort-packages": true
  }
}
